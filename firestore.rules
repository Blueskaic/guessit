rules_version = '2';
// GuessIt rooms. Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // A room can be opened only by someone who knows its code (no listing of rooms) and never changes once created.
    match /rooms/{code} {
      allow get: if true;
      allow create: if code.matches('[A-Z2-9]{5}')
        && request.resource.data.keys().hasOnly(['owner', 'created'])
        && validName(request.resource.data.owner)
        && request.resource.data.created == request.time;

      match /players/{pid} {
        allow read: if roomExists(code);
        allow create: if roomExists(code) && pid.size() <= 40
          && request.resource.data.keys().hasAll(['name', 'ok', 'skip', 'time', 'rounds', 'best', 'secs', 'updated'])
          && validPlayer(request.resource.data);
        allow update: if validPlayer(request.resource.data);
      }
    }

    // Anonymous usage counters (stats/total and one doc per day), read by the analytics page.
    match /stats/{id} {
      allow read: if true;
      allow create, update: if (id == 'total' || id.matches('d[0-9]{8}'))
        && request.resource.data.keys().hasOnly(['visits', 'visitors', 'rounds', 'rounds_nsfw', 'rounds_clean',
             'rounds_timed', 'rounds_free', 'res_ok', 'res_skip', 'res_time', 'dev_ios', 'dev_android', 'dev_desktop',
             't0', 't5', 't10', 't20', 't30', 't60', 'cats'])
        && (!('cats' in request.resource.data) || (request.resource.data.cats is map && request.resource.data.cats.size() <= 40));
    }

    function roomExists(code) { return exists(/databases/$(database)/documents/rooms/$(code)); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 20; }
    function validPlayer(d) {
      return d.keys().hasOnly(['name', 'ok', 'skip', 'time', 'rounds', 'best', 'secs', 'updated'])
        && validName(d.name)
        && d.ok is int && d.skip is int && d.time is int && d.rounds is int && d.best is int && d.secs is number
        && d.updated == request.time;
    }
  }
}
